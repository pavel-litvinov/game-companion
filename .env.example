# For normal use, run npm run local:up; it generates private .local/*.env files.
# These placeholders are only for running the API directly during development.
DATABASE_URL=postgresql://gc_app:your-local-password@localhost:5432/game_companion
PUBLIC_URL=http://localhost:3000
OWNER_ID=your-generated-owner-uuid
OWNER_KEY_HASH=sha256-of-your-generated-local-owner-key
COOKIE_KEY=your-generated-random-cookie-signing-key
OIDC_JWKS={"keys":[]}
HOST=127.0.0.1
PORT=3000
