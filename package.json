{
  "name": "game-companion",
  "version": "0.1.0",
  "description": "Personal game profiles, progress history, and source-backed knowledge.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "mcp:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "local:up": "node scripts/local-up.mjs",
    "local:stop": "docker compose stop",
    "test:local": "node scripts/local-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-litvinov/game-companion.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/pavel-litvinov/game-companion/issues"
  },
  "homepage": "https://github.com/pavel-litvinov/game-companion#readme",
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "oidc-provider": "9.15.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22 <27"
  }
}
